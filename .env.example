# ContractIQ Environment Configuration

# LLM Provider (openai, anthropic, etc.)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=your-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.1

# Embedding model for vector search
EMBEDDING_MODEL=all-MiniLM-L6-v2

# FAISS index storage
FAISS_INDEX_PATH=data/standards_index

# Hybrid retrieval weights
USE_HYBRID_RETRIEVAL=true
VECTOR_WEIGHT=0.7
BM25_WEIGHT=0.3

# PostgreSQL (optional — system runs without it)
DATABASE_URL=postgresql+asyncpg://contract_analyzer:contract_analyzer@localhost:5432/contract_analyzer

# Risk & Compliance Agent endpoints (only A2A services)
RISK_AGENT_URL=http://localhost:8005
RISK_PRIVACY_AGENT_URL=http://localhost:8006
RISK_FINANCIAL_AGENT_URL=http://localhost:8007

# Agent behavior
RISK_AGENT_MAX_ITERATIONS=12
RISK_AGENT_CONFIDENCE_THRESHOLD=0.6

# Verification
VERIFICATION_ENABLED=true
VERIFICATION_FLAG_THRESHOLD=3

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# File upload limit (MB)
MAX_UPLOAD_SIZE_MB=10
