# Contract Regulatory Compliance Scanner — Environment Configuration

# LLM (DeepSeek, OpenAI, or compatible API)
LLM_MODEL=deepseek-chat
OPENAI_API_KEY=your-api-key-here
# OPENAI_BASE_URL=https://api.deepseek.com
LLM_TEMPERATURE=0.1

# Embedding model for vector search
EMBEDDING_MODEL=all-MiniLM-L6-v2

# FAISS index storage
FAISS_INDEX_PATH=data/standards_index

# Hybrid retrieval weights (should sum to ~1.0)
VECTOR_WEIGHT=0.7
BM25_WEIGHT=0.3

# PostgreSQL (optional — system runs without it)
DATABASE_URL=postgresql+asyncpg://contract_analyzer:contract_analyzer@localhost:5432/contract_analyzer

# ReAct agent — max reasoning iterations per contract
RISK_AGENT_MAX_ITERATIONS=10

# Verification — cross-reference findings against retrieved evidence
VERIFICATION_ENABLED=true
VERIFICATION_FLAG_THRESHOLD=2

# File upload limit (MB)
MAX_UPLOAD_SIZE_MB=10
